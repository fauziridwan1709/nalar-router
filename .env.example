# Hosted models (Groq free tier: https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_STRONG_MODEL=openai/gpt-oss-120b

# Local model through any OpenAI-compatible server (default: MLX)
