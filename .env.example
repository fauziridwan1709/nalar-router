# Hosted models (Groq free tier: https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_STRONG_MODEL=openai/gpt-oss-120b

# Local model through any OpenAI-compatible server (default: MLX)
#   ~/.venvs/mlx/bin/mlx_lm.server --model mlx-community/Qwen3.5-4B-MLX-4bit --port 8080
LOCAL_LLM_ENABLED=false
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit

# PORT=3000
# DEMO_MODE=true                 # seeds 4 demo console accounts (one per role) and lists them on the sign-in page
# DEMO_PASSWORD_OPERATOR=        # override a demo password (then it is not shown on the sign-in page)
# BOOTSTRAP_OPERATOR_EMAIL=      # outside demo mode: create one operator account at boot
# BOOTSTRAP_OPERATOR_PASSWORD=
# TRUST_PROXY=1                  # behind one reverse proxy (auto on Render)
# ADMIN_TOKEN=admin-demo-token
# MOCK_TOKEN_DELAY_MS=15
